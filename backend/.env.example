NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:local_postgres_only@localhost:54329/whatsapp_commerce
REDIS_HOST=localhost
REDIS_PORT=56379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_PUBLISHER_ENABLED=true
COMMERCE_WORKER_ENABLED=true
COMMERCE_WORKER_CONCURRENCY=5
WHATSAPP_WEBHOOK_VERIFY_TOKEN=local-fixture-verify-token
WHATSAPP_APP_SECRET=local-fixture-app-secret
METRICS_BEARER_TOKEN=local-fixture-metrics-token-change-me
OUTBOX_PENDING_WARNING=100
OUTBOX_EXPIRED_LEASE_WARNING=1
BULLMQ_FAILED_WARNING=1
WHATSAPP_ADAPTER_MODE=fixture
WHATSAPP_AUTO_REPLY_ENABLED=false
SESSION_TTL_HOURS=8
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/v1/integrations/google-calendar/callback
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
OPENAI_RESPONSE_REWRITING_ENABLED=false
OPENAI_RESPONSE_MODEL=gpt-5.4-nano
OPENAI_RESPONSE_TIMEOUT_MS=8000
OPENAI_API_KEY=
OPENAI_INPUT_COST_MINOR_PER_MILLION=100
OPENAI_OUTPUT_COST_MINOR_PER_MILLION=400
# Solo para WHATSAPP_ADAPTER_MODE=meta:
# WHATSAPP_GRAPH_API_VERSION=vXX.X
# El token de acceso de WhatsApp ya no vive aquí: cada tenant lo configura
# una vez desde el panel de Conexiones (token de System User de Meta, sin
# expiración), y queda cifrado en PostgreSQL con CREDENTIAL_ENCRYPTION_KEY.

# El login local usa sesiones opacas en cookies HttpOnly. Las contraseñas se
# almacenan únicamente como hashes Argon2id en PostgreSQL.
